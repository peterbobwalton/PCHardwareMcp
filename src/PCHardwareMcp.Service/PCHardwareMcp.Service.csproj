<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PCHardwareMcp.Service</RootNamespace>
    <AssemblyName>PCHardwareMcp.Service</AssemblyName>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Debugging from VS needs admin for full sensor data: the manifest asks for it. The installed service runs as LocalSystem. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCHardwareMcp.Core\PCHardwareMcp.Core.csproj" />
  </ItemGroup>

</Project>
